{
  "name": "austral/cache-bundle",
  "type": "symfony-bundle",
  "description": "Cache Austral Bundle",
  "keywords": [
    "Austral",
    "Cache",
    "Symfony"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "Matthieu Beurel",
      "email": "matthieu@austral.dev",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.4 <9.0",
    "austral/contracts": "^4.0",
    "austral/tools-bundle": "^4.0",
    "symfony/http-kernel": "^7.4",
    "symfony/config": "^7.4",
    "symfony/dependency-injection": "^7.4",
    "symfony/yaml": "^7.4",
    "doctrine/orm": "^3.7",
    "doctrine/persistence": "^3.3 || ^4.0",
    "psr/cache": "^2.0 || ^3.0",
    "symfony/cache": "^7.4",
    "symfony/cache-contracts": "^3.5",
    "symfony/console": "^7.4",
    "symfony/event-dispatcher-contracts": "^3.5",
    "symfony/service-contracts": "^3.5"
  },
  "require-dev": {
    "symfony/framework-bundle": "^7.4",
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": "^11.5"
  },
  "suggest": {
    "symfony/framework-bundle": "Creates the cache pools (filesystem or redis adapter)",
    "ext-redis": "Redis adapter, shared between servers (or predis/predis)"
  },
  "config": {
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "Austral\\CacheBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Austral\\CacheBundle\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
